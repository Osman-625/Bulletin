#  Supabase 
# Get these from: supabase.com → your project → Settings → API

# Project URL (safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anon/public key (safe to expose — RLS enforces access control)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key — SECRET. Never expose in the browser.
# Used only in server-side admin actions (user creation, password reset).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

#  App 

NEXT_PUBLIC_APP_URL=http://localhost:3000

#  Scheduled Maintenance (server-only) 
# Vercel Cron sends Authorization: Bearer $CRON_SECRET to protected cron routes.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=replace-with-a-random-cron-secret

# Max orphaned banner objects deleted per scheduled cleanup run.
BANNER_CLEANUP_MAX_DELETES=100

#  Database Backup (server-only / CI-only) 
# Supabase Postgres connection string used by the daily GitHub Actions backup workflow.
SUPABASE_DB_URL=

#  Observability (optional) 

# Public Sentry DSN. Safe to expose; omit locally to keep Sentry disabled.
NEXT_PUBLIC_SENTRY_DSN=

# Source map upload settings for Sentry. Server/CI only.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Product analytics. Public token is safe to expose; omit token to disable.
NEXT_PUBLIC_POSTHOG_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Set to 1 only after launch/privacy review.
NEXT_PUBLIC_POSTHOG_SESSION_REPLAY=0

#  Owner Bootstrap 
# Enable only while running the one-time POST /api/setup endpoint.
# Set back to 0 or remove after the owner account is created.
ENABLE_SETUP_ROUTE=0

# Random secret used to gate the one-time POST /api/setup endpoint while enabled.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SETUP_SECRET=replace-with-a-random-secret

# Owner account identity created by POST /api/setup. Server-only.
# In production, set this to a real owner email before enabling setup.
SETUP_OWNER_EMAIL=owner@example.edu
SETUP_OWNER_USERNAME=campus_owner
# Temporary owner password used by POST /api/setup. Server-only.
# The API response never returns this value; store and share it out-of-band.
SETUP_OWNER_TEMP_PASSWORD=

#  Owner Resources (optional, server-only) 
# Used only by /owner/resources. Never prefix these with NEXT_PUBLIC_.

# Vercel read-only status card. Use the project id from .vercel/project.json or
# Vercel project settings; include VERCEL_TEAM_ID when the project belongs to a team.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
# Optional if the project belongs to a Vercel team
VERCEL_TEAM_ID=

# Supabase Management API read-only health card. Token needs project read access
# for health; analytics usage metrics additionally require analytics_usage_read.
SUPABASE_ACCESS_TOKEN=
# 20-character project ref, or leave blank to infer from NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_PROJECT_REF=

#  E2E Tests (optional) 
# Credentials for pre-seeded test accounts.
# Run scripts/seed-test-users.js to create them.

E2E_DISABLE_RATE_LIMIT=1

TEST_OWNER_EMAIL=owner@example.test
TEST_OWNER_PASSWORD=

TEST_SUPER_ADMIN_EMAIL=test_superadmin@bulletin.internal
TEST_SUPER_ADMIN_PASSWORD=

TEST_ADMIN_EMAIL=test_admin@bulletin.internal
TEST_ADMIN_PASSWORD=

TEST_PUBLISHER_EMAIL=test_publisher@bulletin.internal
TEST_PUBLISHER_PASSWORD=

# Account with force_password_change=true — used for change-password flow tests.
TEST_FORCE_CHANGE_EMAIL=test_forcechange@bulletin.internal
TEST_FORCE_CHANGE_PASSWORD=

# Override if running E2E tests against a non-local URL.
# PLAYWRIGHT_BASE_URL=https://your-preview-url.vercel.app
